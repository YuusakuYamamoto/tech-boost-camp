# Copy this file to terraform.tfvars and fill in your own OCI values.
# terraform.tfvars is gitignored; do not commit it.

# OCI region (e.g., ap-tokyo-1, us-ashburn-1)
region = "ap-tokyo-1"

# Your tenancy OCID
# Find at: OCI Console > User profile menu > Tenancy: <name> > OCID
tenancy_id = "ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Compartment OCID where resources will be created (tbcamp compartment)
# Find at: OCI Console > Identity & Security > Compartments > tbcamp > OCID
compartment_id = "ocid1.compartment.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ssh public key
ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"

# Email address for budget alerts and monitoring alarms.
# The Notifications subscription stays PENDING until you click the
# confirmation link sent to this address.
notification_email = "you@example.com"

# Monthly budget as a whole number, in the currency of your rate card.
# This tenancy's rate card is JPY (the Console shows "予算金額(JPY)"),
# so 1500 is roughly USD 10. It is NOT always USD — check before changing.
budget_amount = 1500
